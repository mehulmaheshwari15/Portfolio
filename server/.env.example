# Backend environment — copy this file to .env and fill in your values.
# Never commit the .env file itself.

# Port the Express server listens on.
# Most PaaS hosts (Render, Railway, Fly.io) inject PORT automatically.
PORT=5001

# Comma-separated list of origins allowed by CORS.
# Add your production frontend URL here when deploying.
# Example: https://mehul.vercel.app,https://www.mehulmaheshwari.dev
FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/mehul_portfolio
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# Leave blank to start the server without database support
# (contact form will return 503; all other endpoints remain available).
MONGODB_URI=